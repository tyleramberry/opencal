# Required: signs sessions and encrypts Google tokens (any long random string)
AUTH_SECRET=

# Google sign-in + calendar (see README). Without these, the owner signs in with ADMIN_PASSWORD.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_PASSWORD=change-me

# First-run defaults (editable later in /admin/settings)
OWNER_USERNAME=tyler
OWNER_NAME=Tyler Amberry
OWNER_TIMEZONE=America/Denver
# The Google account allowed to sign in first and become the owner
OWNER_EMAIL=you@gmail.com

# Public URL, used in email links
APP_URL=http://localhost:3000

# Optional: Postgres (Supabase, Neon...). Leave unset to use the built-in embedded database in .data/
# DATABASE_URL=postgres://...

# Optional: confirmation emails via Resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Tyler <bookings@yourdomain.com>
